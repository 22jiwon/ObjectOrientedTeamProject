<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />


    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="chaekimjeo7"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.chaekimjeo7"
        tools:targetApi="31">
        <activity
            android:name=".UI.LogoActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--  채팅방 화면  -->
        <activity android:name="com.example.chaekimjeo7.UI.chat.room.ChatRoomActivity" android:windowSoftInputMode="adjustResize"/>
        <!--  채팅 목록 화면  -->
        <activity android:name="com.example.chaekimjeo7.UI.chat.list.ChatListActivity"/>
        <!--  교재 등록 화면  -->
        <activity android:name="com.example.chaekimjeo7.UI.main.book.BookRegisterActivity"/>
        <!--  교재 상세(구매) 화면  -->
        <activity android:name="com.example.chaekimjeo7.UI.main.book.BookSellDetailActivity"/>
        <!--  교재 상세(판매) 화면  -->
        <activity android:name="com.example.chaekimjeo7.UI.main.book.BookPurchaseDetailActivity"/>
        <!--  교재 목록 (전체)  -->
        <activity android:name="com.example.chaekimjeo7.UI.main.book.BookListAllActivity"/>
        <activity android:name="com.example.chaekimjeo7.UI.main.book.BookListByCategoryActivity"/>
        <!--  단일 채팅 기능 (판매자와의 문의용)  -->
        <activity android:name="com.example.chaekimjeo7.UI.chat.ChatActivity"/>

        <activity android:name=".UI.main.MainActivity"/>
        <activity android:name=".UI.mypage.buy.BuyHistoryActivity"/>
        <activity android:name=".UI.mypage.favorite.FavoritesActivity"/>
        <activity android:name=".UI.auth.LoginActivity"/>
        <activity android:name=".UI.auth.Signup1Activity"/>
        <activity android:name=".UI.auth.Signup2Activity"/>
        <activity android:name=".UI.mypage.MyPageActivity"/>
        <activity android:name=".UI.mypage.sales.SalesHistoryActivity" />

    </application>

</manifest>